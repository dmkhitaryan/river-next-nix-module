let
  # A git repository, checked out the way Zig reads it: every file as
  # committed. An ordinary checkout applies the repository's `.gitattributes`,
  # which can rewrite a file's line endings or run it through a filter, and
  # the package would then no longer match its hash. Pointing git at its
  # built-in empty tree for attributes turns them all off, and `core.autocrlf`
  # is turned off too, since it converts line endings even without them.
  # zon2nix computes the hash with exactly these settings.
  fetchZigGit =
    args:
    fetchgit (
      args
      // {
        fetchSubmodules = false;
        preFetch = ''
          export GIT_ATTR_SOURCE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
          export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.autocrlf GIT_CONFIG_VALUE_0=false
        '';
      }
    );

  # Every package, by the hash Zig knows it by, as Nix fetches it.
  packages = {
    "toml-0.3.0-bV14BRmkAQDSILPPyXc31aAXPtJa1Uh8Frug3i6InAUc" = fetchZigGit {
      name = "toml";
      url = "https://github.com/sam701/zig-toml";
      rev = "c661327bd9f02f774426c4fe78f60621411b7173";
      hash = "sha256-dS6b8nkpU54W3adoxKuGSgqkpkJ2pwktRfLABzuvBd8=";
    };
    "wayland-0.8.0-dev-lQa1kuf8AQCeoam8G-XPyaIYvIOk3_wgsspwi4nT_L5q" = fetchZigGit {
      name = "wayland";
      url = "https://codeberg.org/ifreund/zig-wayland.git";
      rev = "94db7ba4e0a6b4780a16dbc74c7a2c88f1ebf502";
      hash = "sha256-vuro4OJOIjgBvL8dbOF4HyXmem71l7PKx5SJMeRk0N4=";
    };
    "xkbcommon-0.5.0-dev-VDqIe0y2AgA1RzA2ICMdGhaAgSXdhtRTbYybQQu7WfOa" = fetchZigGit {
      name = "xkbcommon";
      url = "https://codeberg.org/ifreund/zig-xkbcommon.git";
      rev = "6c2f41e269adde0d2cd58d20c02c4f8803d83eb1";
      hash = "sha256-vreObBYsAsb33qKdTpQGFqPbweidMw+L1MRWxqwq07E=";
